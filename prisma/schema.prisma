  @@map("post")
}

model Reservation {
  id             Int          @id @default(autoincrement())
  userId         Int?         @map("user_id")
  transactionId  Int?         @map("transaction_id")
  sessionId      Int?         @map("session_id")
  isAvailable    Boolean      @map("is_available")
  placeNumber    Int          @map("place_number") @db.SmallInt
  cancellationAt DateTime?    @map("cancellation_at") @db.DateTime(0)
  createdAt      DateTime?    @map("created_at") @db.DateTime(0)
  updatedAt      DateTime?    @map("updated_at") @db.DateTime(0)
