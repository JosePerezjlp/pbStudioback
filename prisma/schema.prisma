  @@index([reservationId, createdAt], map: "idx_reservation_events")
  @@index([userId], map: "idx_user_events")
  @@index([sessionId], map: "idx_session_events")
  @@index([eventType, createdAt], map: "idx_event_type")
  @@map("reservation_event")
}

