  package               Package?        @relation(fields: [packageId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_723705D1F44CABFF")
  branchOffice          BranchOffice?   @relation(fields: [branchOfficeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_723705D1FD2AF2F7")

