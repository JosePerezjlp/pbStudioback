  session        Session?     @relation(fields: [sessionId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_42C84955613FECDF")
  user           User?        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_42C84955A76ED395")

  @@index([placeNumber], map: "place_number_idx")
  @@index([transactionId], map: "IDX_42C849552FC0CB0F")
  @@index([sessionId], map: "IDX_42C84955613FECDF")
  @@index([userId], map: "IDX_42C84955A76ED395")
  @@map("reservation")
}

model ReservationEvent {
