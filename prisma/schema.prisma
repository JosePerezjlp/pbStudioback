  branchOffice       BranchOffice? @relation(fields: [branchOfficeId], references: [id], onDelete: Restrict, onUpdate: Restrict, map: "FK_2BBA3329FD2AF2F7")
  sessions           Session[]

  @@index([disciplineId], map: "IDX_2BBA3329A5522701")
  @@index([branchOfficeId], map: "IDX_2BBA3329FD2AF2F7")
  @@map("exercise_room")
}

model InstructorsDisciplines {
  staffId      Int        @map("staff_id")
  disciplineId Int        @map("discipline_id")
  discipline   Discipline @relation(fields: [disciplineId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_2DE67534A5522701")
  staff        Staff      @relation(fields: [staffId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_2DE67534D4D57CD")

  @@id([staffId, disciplineId])
  @@index([disciplineId], map: "IDX_2DE67534A5522701")
  @@index([staffId], map: "IDX_2DE67534D4D57CD")
  @@map("instructors_disciplines")
}

model Package {
  id             Int             @id @default(autoincrement())
  totalClasses   Int             @map("total_classes")
