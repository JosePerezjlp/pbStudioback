generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model BranchOffice {
  id                 Int                 @id @default(autoincrement())
  name               String              @unique(map: "UNIQ_81301E575E237E06") @db.VarChar(255)
  isActive           Boolean             @map("is_active")
  createdAt          DateTime?           @map("created_at") @db.DateTime(0)
  isPublic           Boolean             @default(false) @map("public")
  location           String?             @map("place") @db.VarChar(100)
  address            String?             @db.VarChar(255)
  phone              String?             @db.VarChar(50)
  area               String?             @db.VarChar(100)
  slug               String?             @db.VarChar(255)
  updatedAt          DateTime?           @map("updated_at") @db.DateTime(0)
  exerciseRooms      ExerciseRoom[]
  sessions           Session[]
  staffBranchOffices StaffBranchOffice[]
  transactions       Transaction[]
  users              User[]

  @@map("branch_office")
}

model Configuration {
  id     Int    @id @default(autoincrement())
  module String @db.VarChar(100)
  data   String @db.LongText

  @@map("configuration")
}

model Coupon {
  id                Int             @id @default(autoincrement())
  name              String          @db.VarChar(100)
  code              String          @unique(map: "UNIQ_64BF3F0277153098") @db.VarChar(20)
  dateStart         DateTime?       @map("date_start") @db.Date
  dateEnd           DateTime?       @map("date_end") @db.Date
  discount          Decimal         @db.Decimal(4, 2)
  usesTotal         Int             @map("uses_total")
  applySpecialPrice Boolean         @default(false) @map("apply_special_price")
  used              Int             @default(0)
  createdAt         DateTime?       @map("created_at") @db.DateTime(0)
  updatedAt         DateTime?       @map("updated_at") @db.DateTime(0)
  couponHistories   CouponHistory[]
  couponPackages    CouponPackage[]
  transactions      Transaction[]

  @@map("coupon")
}

model CouponHistory {
  id            Int         @id @default(autoincrement())
  couponId      Int         @map("coupon_id")
  transactionId Int         @map("transaction_id")
  userId        Int         @map("user_id")
  discount      Decimal     @db.Decimal(4, 2)
  createdAt     DateTime?   @map("created_at") @db.DateTime(0)
  updatedAt     DateTime?   @map("updated_at") @db.DateTime(0)
  transaction   Transaction @relation(fields: [transactionId], references: [id], onUpdate: Restrict, map: "FK_C8D233DD2FC0CB0F")
  coupon        Coupon      @relation(fields: [couponId], references: [id], onUpdate: Restrict, map: "FK_C8D233DD66C5951B")
  user          User        @relation(fields: [userId], references: [id], onUpdate: Restrict, map: "FK_C8D233DDA76ED395")

  @@index([transactionId], map: "IDX_C8D233DD2FC0CB0F")
  @@index([couponId], map: "IDX_C8D233DD66C5951B")
  @@index([userId], map: "IDX_C8D233DDA76ED395")
  @@map("coupon_history")
}

model CouponPackage {
  couponId  Int     @map("coupon_id")
  packageId Int     @map("package_id")
  coupon    Coupon  @relation(fields: [couponId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_3100240366C5951B")
  package   Package @relation(fields: [packageId], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "FK_31002403F44CABFF")

  @@id([couponId, packageId])
  @@index([couponId], map: "IDX_3100240366C5951B")
  @@index([packageId], map: "IDX_31002403F44CABFF")
  @@map("coupon_package")
}

model Discipline {
  id                     Int                      @id @default(autoincrement())
  name                   String                   @unique(map: "UNIQ_75BEEE3F5E237E06") @db.VarChar(100)
  description            String?                  @db.LongText
  isActive               Boolean                  @map("is_active")
  createdAt              DateTime?                @map("created_at") @db.DateTime(0)
  updatedAt              DateTime?                @map("updated_at") @db.DateTime(0)
  exerciseRooms          ExerciseRoom[]
  instructorsDisciplines InstructorsDisciplines[]
  sessions               Session[]

  @@map("discipline")
}

model ExerciseRoom {
  id                 Int           @id @default(autoincrement())
  name               String        @db.VarChar(100)
  type               String        @db.VarChar(25)
  capacity           Int
  isActive           Boolean       @map("is_active")
  createdAt          DateTime?     @map("created_at") @db.DateTime(0)
